  presetRain: 00010000
  presets:
  - label: 01  PORTICO / fine edges
    description: Thin, pixel-scaled edges and quiet solid faces. Small pulses travel
      on the perimeter; architecture remains sparse.
    material: {fileID: 2100000, guid: e70435890352980489fa13fe11023190, type: 2}
    parameters:
    - label: Edge width (pixels)
      property: _EdgeWidth
      min: 0.25
      max: 1.6
    - label: Line strength
      property: _EdgeStrength
      min: 0.1
      max: 1
    - label: Pulse speed
      property: _PulseSpeed
      min: -0.5
      max: 0.5
    - label: Pulse amount
      property: _PulseAmount
      min: 0
      max: 1
  - label: 02  RAIN / layered depth
    description: Strictly vertical rain. Along each fixed straight path the upper
      region fades out as the lower region appears; no sideways motion.
    material: {fileID: 2100000, guid: e70435890352980489fa13fe11023190, type: 2}
    parameters:
    - label: Edge width (pixels)
      property: _EdgeWidth
      min: 0.25
      max: 1.6
    - label: Front value
      property: _FaceValue
      min: 0
      max: 0.8
    - label: Side value
      property: _SideValue
      min: 0
      max: 0.4
    - label: Line strength
      property: _EdgeStrength
      min: 0.1
      max: 1
  - label: 03  CURRENT / etched flow
    description: Evolving analytic gradients bend a local current of fine contours.
      Broad unmarked borders keep the pattern inside each target.
    material: {fileID: 2100000, guid: 4d4a9751d0f56ea4e969ae50c69631e1, type: 2}
    parameters:
    - label: Contour count
      property: _Frequency
      min: 3
      max: 24
    - label: Curvature
      property: _Curvature
      min: 0
      max: 0.9
    - label: Evolution speed
      property: _Speed
      min: -0.5
      max: 0.5
    - label: Stroke width (pixels)
      property: _LineWidth
      min: 0.3
      max: 1.6
  - label: 04  EXISTING / matte baseline
    description: Current V5 matte material on the same targets, camera and Color
      Map. Use Apply and split comparison to check compatibility.
    material: {fileID: 2100000, guid: fa3d66eaef042694db1037aa7f67386c, type: 2}
    parameters:
    - label: Smoothness
      property: _Smoothness
      min: 0
      max: 1
