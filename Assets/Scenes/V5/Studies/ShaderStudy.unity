  stageCamera: {fileID: 1367202740}
  focus: {fileID: 1023713492}
  subjects:
  - {fileID: 558258456}
  - {fileID: 1414087247}
  - {fileID: 219951418}
  - {fileID: 1040468832}
  - {fileID: 1281827756}
  - {fileID: 889040427}
  floor: {fileID: 1436342001}
  squares: {fileID: 2073112585}
  rain: {fileID: 912904568}
  presets:
  - label: 01  Circuit streams
    description: Fixed right-angle paths. Packets move along each path and turn at
      the junctions; no scrolling image.
    material: {fileID: 2100000, guid: 63febc9165a20604190ab6b82a3fc8a2, type: 2}
    parameters:
    - label: Pattern scale
      property: _Scale
      min: 1
      max: 12
    - label: Stroke width
      property: _LineWidth
      min: 0.005
      max: 0.15
    - label: Flow speed / direction
      property: _Speed
      min: -2
      max: 2
    - label: Activity
      property: _Density
      min: 0.1
      max: 1
  - label: 02  Expanding frames
    description: Square fronts grow outwards while small pulses travel around their
      perimeter. Cell timing is staggered.
    material: {fileID: 2100000, guid: e85dc3b15e3ea5948b9935048238ab09, type: 2}
    parameters:
    - label: Pattern scale
      property: _Scale
      min: 1
      max: 12
    - label: Stroke width
      property: _LineWidth
      min: 0.005
      max: 0.15
    - label: Flow speed / direction
      property: _Speed
      min: -2
      max: 2
    - label: Activity
      property: _Density
      min: 0.1
      max: 1
  - label: 03  Tile cascade
    description: Cells activate in a diagonal relay. Filled squares and outlines
      grow, hold and retract at different phases.
    material: {fileID: 2100000, guid: 5b550cc4b1690764e9eee2e6a9a60d07, type: 2}
    parameters:
    - label: Pattern scale
      property: _Scale
      min: 1
      max: 12
    - label: Stroke width
      property: _LineWidth
      min: 0.005
      max: 0.15
    - label: Flow speed / direction
      property: _Speed
      min: -2
      max: 2
    - label: Activity
      property: _Density
      min: 0.1
      max: 1
  - label: 04  Existing toon passage
    description: The current V5 flat, three-value surface. Static baseline for comparison;
      original asset stays unchanged.
    material: {fileID: 2100000, guid: a7af4f6cf4393574292de8593856bbcd, type: 2}
    parameters:
    - label: Edge width (pixels)
      property: _EdgeWidth
      min: 0
      max: 3
    - label: White front faces
      property: _FrontWhite
      min: 0
      max: 1
  - label: 05  Existing filaments
    description: Current V5 straight moving lines. Originally authored for narrow
      ribbons; mesh UVs change their layout. Uses Unity time, not Pause studies.
    material: {fileID: 2100000, guid: 2e89de59a4a3ca54ba1fa02343e12483, type: 2}
    parameters:
    - label: Flow speed
      property: _FlowSpeed
      min: -2
      max: 2
    - label: Repeat length
      property: _RepeatLength
      min: 0.1
      max: 3
    - label: Visibility
      property: _Visibility
      min: 0
      max: 1
  - label: 06  Existing URP matte
    description: Native URP material under a neutral directional light. Tests compatibility
      with the same Color Map stage.
    material: {fileID: 2100000, guid: fa3d66eaef042694db1037aa7f67386c, type: 2}
    parameters:
    - label: Smoothness
      property: _Smoothness
      min: 0
      max: 1
